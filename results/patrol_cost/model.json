  "assumptions": {
   "patrol_window_h": {
    "value": 8.0,
    "reason": "one daylight shift, e.g. 08:00 to 16:00; the valley flights start at 08:00"
   },
   "airtime_share": {
    "value": 0.5,
    "reason": "each drone is airborne half the window: 22-minute flights and battery swaps. Charging sets the ceiling: the build sheet's two chargers give 1,000 W on mains, which with the three charged packs each drone starts with keeps a 16-drone squad airborne at most about 60 to 70% of an 8-hour shift (see max_airtime_share), so 0.5 leaves room for weather holds and checks; the 75% rows of the sensitivity would need a DC supply"
   },
   "scan_share": {
    "value": 0.5,
    "reason": "half of airborne time is scanning, the rest is launch, transit, turns and landing; the build sheet's own conservative case (COSTS.md)"
   },
   "scan_rate_per_drone_ha_min": {
    "value": 0.3875,
    "reason": "the 16-drone measured rate divided by 16 (0.39 ha/min); 4 drones measured 0.40 per drone, a single drone 0.50"
   },
   "crew_people_per_16_drones": {
    "value": 2,
    "reason": "a remote pilot and an observer or mission lead per 16 drones, as the build sheet costs its swarm; this needs an FAA one-to-many waiver (Part 107.35) or the proposed Part 108"
   },
   "smoke_watch_radius_km": {
    "value": 2.5,
    "reason": "the simulator's haze limit: a loitering drone's forward camera notices a spreading fire's plume anywhere within it (the valley flights found the fire across the valley this way); real cameras on towers see much further, so this is conservative"
   },
   "season_days": {
    "value": 120,
    "reason": "a four-month fire season of daily patrol, for the season totals"
   },
   "strike_site_block_km2": {
    "value": 0.15,
    "reason": "the valley's 500 x 300 m block, swept in the measured valley flight time"
   },
   "strike_blocks_per_site": {
    "value": 2,
    "reason": "each strike is checked as two blocks side by side, 500 x 600 m centred on the reported strike. The US lightning network's median location error is about 200 m (Nag et al. 2014); with errors spread evenly in all directions (a circular normal, sigma 170 m), one 500 x 300 m block holds about 54% of strikes and two about 79% (see block_holds_share)"
   },
   "site_cycle_min_drive_and_fly": {
    "value": 15.0,
    "reason": "drive-and-fly: the crew drives the squad to each site; launch, the measured flight, landing and a battery check, at least 15 minutes a site including a short drive, or the flight plus 8 minutes when that is longer"
   },
   "site_spacing_km_fly_between": {
    "value": 1.0,
    "reason": "fly-between: sites 1 km apart along a storm track, flown at the scout's 6 m/s"
   },
   "usable_sortie_min": {
    "value": 20.0,
    "reason": "a sortie of 17 to 22 minutes between battery swaps (hardware/README.md); 20 used"
   }
  }
 },
