# Copy to your shell or your cloud environment's variables. Never commit a real key.
# Nothing here is needed to run the simulator, the benchmarks or the dashboard's replays.
NEBIUS_API_KEY=
# Optional overrides
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
HALO_SUPERVISOR_MODEL=
# USD per million tokens, from the Token Factory pricing page. Leave empty to use the built-in
# price ceilings, which deliberately over-estimate cost.
NEBIUS_PRICE_INPUT_PER_M=
NEBIUS_PRICE_OUTPUT_PER_M=
# Spend guard: model calls stop once the estimated total in the ledger would pass the cap (USD).
HALO_BUDGET_USD=18
HALO_LEDGER=~/.halo-systems/nebius_ledger.jsonl
# The names used before the rename (SWARMLAB_SUPERVISOR_MODEL, SWARMLAB_BUDGET_USD, SWARMLAB_LEDGER)
# are still read when the HALO_ ones are unset.
